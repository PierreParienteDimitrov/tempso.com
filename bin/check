#!/usr/bin/env bash
# The single gate for tempso-com. The pre-push hook runs it with no flags;
# `npm run check` and `npm run pre-push` are aliases for it.
#
#   bin/check          hook self-test, app-config.json, lint, type-check, build
#   bin/check --fast   skips the build
#   bin/check --full   same as no flag today; accepted so CI can call it like
#                      the other repos' gates
#
# Steps run cheapest first, stop at the first failure, and each prints a count,
# so a step that silently checked nothing can't pass as green.
set -euo pipefail

mode=default
for arg in "$@"; do
  case "$arg" in
  --fast | --full)
    [ "$mode" = default ] || { echo "bin/check: pass at most one of --fast / --full" >&2; exit 2; }
    mode="${arg#--}"
    ;;
  -h | --help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) echo "bin/check: unknown option: $arg (usage: bin/check [--fast | --full])" >&2; exit 2 ;;
  esac
done

cd "$(dirname "$0")/.."

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

step() { printf '\n==> %s\n' "$1"; }
fail() { printf '\nbin/check: FAILED at step: %s\n' "$1" >&2; exit 1; }

if [ ! -d node_modules ]; then
  echo "bin/check: node_modules/ is missing. Run npm ci first." >&2
  exit 1
fi

# 1. The pre-commit hook's own path rules, both directions.
step "1. pre-commit hook self-test"
.githooks/pre-commit --self-test >"$tmp/hook.log" 2>&1 || { cat "$tmp/hook.log"; fail "pre-commit --self-test"; }
cases="$(grep -c '^  ok ' "$tmp/hook.log" || true)"
[ "$cases" -gt 0 ] || fail "pre-commit --self-test ran 0 cases"
echo "$cases hook rule cases passed"

# 2. app-config.json, which the live Flutter app's force-update gate reads.
#    Self-test first, so a validator that can't fire doesn't pass silently.
step "2. app-config.json"
node scripts/check-app-config.mjs --self-test >"$tmp/appcfg.log" 2>&1 || { cat "$tmp/appcfg.log"; fail "check-app-config --self-test"; }
tail -n 1 "$tmp/appcfg.log"
node scripts/check-app-config.mjs public/app-config.json || fail "public/app-config.json"

# 3. ESLint. --max-warnings 50 is a calibrated tolerance, so report how many
#    warnings were tolerated, not just "green".
step "3. lint"
lint_rc=0
npm run --silent lint -- --format json --output-file "$tmp/eslint.json" || lint_rc=$?
[ -s "$tmp/eslint.json" ] || fail "lint (eslint wrote no report, exit $lint_rc)"
node -e '
  const r = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
  const sum = (k) => r.reduce((n, f) => n + f[k], 0);
  if (process.argv[2] !== "0") {
    for (const f of r) for (const m of f.messages)
      console.log(`${f.filePath}:${m.line}:${m.column} ${m.severity === 2 ? "error" : "warning"} ${m.message} (${m.ruleId})`);
  }
  console.log(`${r.length} files linted, ${sum("errorCount")} errors, ${sum("warningCount")} warnings (tolerance 50)`);
  if (r.length === 0) process.exit(1);
' "$tmp/eslint.json" "$lint_rc" || fail "lint (0 files linted)"
[ "$lint_rc" -eq 0 ] || fail "lint"

# 4. TypeScript.
step "4. type-check"
npm run --silent type-check -- --diagnostics >"$tmp/tsc.log" 2>&1 || { grep -v -E '^[A-Z][A-Za-z /()]+: ' "$tmp/tsc.log" | tail -n 40; fail "type-check"; }
files="$(sed -nE 's/^Files: +([0-9]+)$/\1/p' "$tmp/tsc.log")"
[ "${files:-0}" -gt 0 ] || fail "type-check checked 0 files"
echo "$files files type-checked, 0 errors"

if [ "$mode" = fast ]; then
  printf '\nbin/check --fast: all steps passed (build skipped)\n'
  exit 0
fi

# 5. Production build, the same command Vercel runs.
step "5. build"
npm run --silent build >"$tmp/build.log" 2>&1 || { tail -n 40 "$tmp/build.log"; fail "build"; }
routes="$(node -e 'console.log(Object.keys(require(process.argv[1])).length)' "$PWD/.next/app-path-routes-manifest.json" 2>/dev/null || echo 0)"
[ "$routes" -gt 0 ] || fail "build produced 0 app routes"
echo "$routes app routes built"

printf '\nbin/check: all steps passed (%s)\n' "$mode"
