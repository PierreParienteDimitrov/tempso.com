#!/bin/bash

# Pre-push hook: secret scan, then the single gate (bin/check).
# The hook's exit status is the first failing step's exit status.

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

cd "$(git rev-parse --show-toplevel)" || exit 1

status=0

if command -v ggshield >/dev/null 2>&1; then
  ggshield secret scan pre-push "$@" || status=$?
else
  echo -e "${YELLOW}[Pre-push] ggshield not on PATH: secret scan skipped${NC}"
fi

if [ "$status" -eq 0 ]; then
  bin/check || status=$?
fi

if [ "$status" -ne 0 ]; then
  echo -e "${RED}[Pre-push] Push blocked: fix the cause; don't use --no-verify.${NC}" >&2
fi
exit "$status"
